# Leave both unset to run the storefront on the bundled demo catalog (no backend needed).
# To use the local WooCommerce backend from ../wordpress, copy this file to .env.local:
WC_STORE_URL=http://localhost:8080
NEXT_PUBLIC_COMMERCE_MODE=woocommerce

# Public URL of the deployed store, for the sitemap and structured data.
# NEXT_PUBLIC_SITE_URL=https://your-store.example
